# ─── Wallet / RPC ───────────────────────────────────────────────────────
# WalletConnect / Reown project id (free, https://cloud.reown.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Mantle RPCs (override for paid providers)
NEXT_PUBLIC_MANTLE_SEPOLIA_RPC=https://rpc.sepolia.mantle.xyz
NEXT_PUBLIC_MANTLE_MAINNET_RPC=https://rpc.mantle.xyz

# ─── Squadium · Mantle Sepolia deployment (2026-05-19) ──────────────────
# These are pre-baked as fallbacks in src/lib/contracts.ts so the dapp Just
# Works without env vars. Override per-deploy by setting the vars here.
# Source: contracts/deployments.md
NEXT_PUBLIC_AGENT_REGISTRY_SEPOLIA_ADDRESS=0x5C8061694C8c1b4A2aB39762754D9a0DC549fBB1
NEXT_PUBLIC_AGENT_REPUTATION_ORACLE_SEPOLIA_ADDRESS=0x6a9aff1F4352648b39De2771A1Ed3f0F85E9D764
NEXT_PUBLIC_SQUADIUM_SEPOLIA_ADDRESS=0x4299b716F33Be7F43D0Ebf0c1F4863D3fC4b37ec
NEXT_PUBLIC_LIQUID_REPUTATION_SEPOLIA_ADDRESS=0xE633d2bBb9D610A3dA777a651C1497257a159557
NEXT_PUBLIC_REWARD_DISTRIBUTOR_SEPOLIA_ADDRESS=0x2E4567125B73eEdA6b6B276a7ea7a9a4bd44aC22
NEXT_PUBLIC_REPUTATION_GATED_POOL_SEPOLIA_ADDRESS=0x30A9F0d212227d47fBb1D6dF1431E7802376Ea33

# Mainnet — planned W4 if Sepolia run validates clean
NEXT_PUBLIC_AGENT_REGISTRY_MAINNET_ADDRESS=
NEXT_PUBLIC_AGENT_REPUTATION_ORACLE_MAINNET_ADDRESS=
NEXT_PUBLIC_SQUADIUM_MAINNET_ADDRESS=
